<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kelola_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="KELOLA"
        android:textAllCaps="true"
        android:textColor="@color/kelola_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_alias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Widget off"
        android:textColor="@color/kelola_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Enable in Kelola"
        android:textColor="@color/kelola_muted"
        android:textSize="12sp" />
</LinearLayout>
